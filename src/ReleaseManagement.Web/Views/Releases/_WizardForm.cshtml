@using ReleaseManagement.Domain.Rules
@model ReleaseWizardViewModel
@{
    var formAction = (string?)ViewData["FormAction"] ?? "Create";
    var stepNames = new[] { "General & window", "Services", "Classification", "Source links", "Readiness plans", "Review" };
    var majorCriteria = new (ClassificationCriteria Value, string Label)[]
    {
        (ClassificationCriteria.SignificantCustomerImpact, "Significant customer / business impact"),
        (ClassificationCriteria.DowntimeOnCriticalService, "Downtime on a critical customer-facing service"),
        (ClassificationCriteria.MultiTeamCoordination, "Multi-team coordinated deployment"),
        (ClassificationCriteria.ComplexDataMigration, "Complex DB / data migration"),
        (ClassificationCriteria.ComplexRecovery, "Complex recovery / backout"),
        (ClassificationCriteria.HighBusinessSignificance, "High business significance (regulatory, strategic)")
    };
    var normalCriteria = new (ClassificationCriteria Value, string Label)[]
    {
        (ClassificationCriteria.ModerateCustomerImpact, "Moderate customer impact"),
        (ClassificationCriteria.LimitedDowntime, "Limited downtime"),
        (ClassificationCriteria.SchemaOrDataChange, "Schema or data change"),
        (ClassificationCriteria.SharedComponentImpact, "Shared / core component impact")
    };
    var securityTriggers = new (SecurityTriggers Value, string Label)[]
    {
        (SecurityTriggers.NewInternetFacingApplication, "New internet-facing application"),
        (SecurityTriggers.NewExternalApi, "New external API"),
        (SecurityTriggers.SignificantAuthorizationChange, "Significant authorization change"),
        (SecurityTriggers.SensitiveDataChange, "Sensitive data change"),
        (SecurityTriggers.SecurityArchitectureChange, "Security architecture change"),
        (SecurityTriggers.InfoSecRiskRequest, "InfoSec risk request"),
        (SecurityTriggers.RegulatoryOrContractRequirement, "Regulatory / contract requirement")
    };
    var referenceTypes = new[]
    {
        ReleaseReferenceType.WorkItem, ReleaseReferenceType.PullRequest, ReleaseReferenceType.Pipeline,
        ReleaseReferenceType.Artifact, ReleaseReferenceType.ServiceDeskChange, ReleaseReferenceType.TestEvidence,
        ReleaseReferenceType.SecurityAssessment, ReleaseReferenceType.MonitoringDashboard, ReleaseReferenceType.Other
    };
}

<div class="wizard-steps" aria-label="Release wizard progress">
    @for (var index = 0; index < stepNames.Length; index++)
    {
        <span class="wizard-step @(Model.Step == index + 1 ? "active" : "")">@(index + 1). @stepNames[index]</span>
    }
</div>

<form action="@Url.Action(formAction, "Releases")" method="post" id="release-wizard-form">
    @Html.AntiForgeryToken()
    <input asp-for="ReleaseId" type="hidden" />
    <input asp-for="Step" type="hidden" />
    <input asp-for="PlannedReleaseDate" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (Model.FreezeWarnings.Any())
    {
        <div class="alert alert-warning">
            <strong>Release freeze (§6.3):</strong> the planned window overlaps an active freeze. Reschedule or ask the Release Manager to record an exception approved by the freeze authority.
            <ul class="mb-0">
                @foreach (var warning in Model.FreezeWarnings) { <li>@warning</li> }
            </ul>
        </div>
    }

    <section class="panel @(Model.Step == 1 ? "" : "d-none")">
        <h2 class="h5">General information &amp; planned window</h2>
        <p class="text-muted">Track: <strong>Application</strong> (Azure Boards + SDLC). Infrastructure changes come from Service Desk and are out of scope today.</p>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReleaseVersion" class="form-label"></label>
                <input asp-for="ReleaseVersion" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId" class="form-select" asp-items="@(new SelectList(Model.Products, "Id", "Name"))">
                    <option value="">Select a product</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="EnvironmentId" class="form-label"></label>
                <select asp-for="EnvironmentId" class="form-select" asp-items="@(new SelectList(Model.Environments, "Id", "Name"))">
                    <option value="">Select an environment</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="PlannedWindowStart" class="form-label"></label>
                <input asp-for="PlannedWindowStart" type="datetime-local" class="form-control" />
                <span asp-validation-for="PlannedWindowStart" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="PlannedWindowEnd" class="form-label"></label>
                <input asp-for="PlannedWindowEnd" type="datetime-local" class="form-control" />
                <span asp-validation-for="PlannedWindowEnd" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TechnicalOwnerUserId" class="form-label"></label>
                <select asp-for="TechnicalOwnerUserId" class="form-select" asp-items="@(new SelectList(Model.TechnicalOwners, "Id", "Name"))">
                    <option value="">Assigned by Release Manager</option>
                </select>
            </div>
            <div class="col-md-4">
                <div class="form-check mt-4">
                    <input asp-for="PlannedMaintenance" class="form-check-input" />
                    <label asp-for="PlannedMaintenance" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-md-8">
                <label asp-for="MaintenanceApprovalReference" class="form-label"></label>
                <input asp-for="MaintenanceApprovalReference" class="form-control" placeholder="Approved maintenance window reference (§6.1)" />
            </div>
            <div class="col-md-6">
                <label asp-for="ForecastId" class="form-label"></label>
                <select asp-for="ForecastId" class="form-select" asp-items="@(new SelectList(Model.Forecasts, "Id", "Name"))">
                    <option value="">Not in the quarterly forecast</option>
                </select>
                <div class="form-text">Major planned releases must be listed in the quarterly forecast (§3.1).</div>
            </div>
            <div class="col-md-6">
                <label asp-for="KeyDependencies" class="form-label"></label>
                <input asp-for="KeyDependencies" class="form-control" placeholder="Other releases, teams, vendors, infrastructure changes" />
            </div>
            <div class="col-12">
                <label asp-for="ImpactDescription" class="form-label"></label>
                <textarea asp-for="ImpactDescription" class="form-control" rows="2" placeholder="Expected customer / business impact"></textarea>
            </div>
        </div>
    </section>

    <section class="panel @(Model.Step == 2 ? "" : "d-none")">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h5 mb-1">Services</h2>
                <p class="text-muted mb-0">Select the services and identify the artifacts included in this release.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="add-service-row">Add service</button>
        </div>
        <div id="services-grid" class="services-grid">
            @for (var i = 0; i < Model.Services.Count; i++)
            {
                <div class="service-row panel panel-nested" data-service-row>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="service-row-title">Service @(i + 1)</strong>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove-service>Remove</button>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Service</label>
                            <select name="Services[@i].ServiceId" class="form-select" asp-items="@(new SelectList(Model.AvailableServices, "Id", "Name", Model.Services[i].ServiceId))">
                                <option value="">Select service</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Branch</label>
                            <input name="Services[@i].BranchName" value="@Model.Services[i].BranchName" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Commit</label>
                            <input name="Services[@i].CommitId" value="@Model.Services[i].CommitId" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Version</label>
                            <input name="Services[@i].Version" value="@Model.Services[i].Version" class="form-control" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Build</label>
                            <input name="Services[@i].BuildNumber" value="@Model.Services[i].BuildNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Repository URL</label>
                            <input name="Services[@i].RepositoryUrl" value="@Model.Services[i].RepositoryUrl" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Notes</label>
                            <input name="Services[@i].Notes" value="@Model.Services[i].Notes" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input type="checkbox" name="Services[@i].DatabaseChanges" value="true" class="form-check-input" id="Services_@(i)__DatabaseChanges" @(Model.Services[i].DatabaseChanges ? "checked" : null) />
                                <label class="form-check-label" for="Services_@(i)__DatabaseChanges">Database changes</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-2">
                                <input type="checkbox" name="Services[@i].ConfigurationChanges" value="true" class="form-check-input" id="Services_@(i)__ConfigurationChanges" @(Model.Services[i].ConfigurationChanges ? "checked" : null) />
                                <label class="form-check-label" for="Services_@(i)__ConfigurationChanges">Configuration changes</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="panel @(Model.Step == 3 ? "" : "d-none")">
        <h2 class="h5">Classification (§4.1) and execution mode (§4.2)</h2>
        <p class="text-muted">Any significant Major criterion makes the whole release Major; otherwise Normal impact makes it Normal; otherwise Minor. Database changes and planned downtime raise the release to at least Normal.</p>
        <div class="row g-4">
            <div class="col-lg-6">
                <h3 class="h6">Major criteria</h3>
                @foreach (var criterion in majorCriteria)
                {
                    <div class="form-check">
                        <input type="checkbox" name="Criteria" value="@criterion.Value" class="form-check-input" id="crit_@criterion.Value" data-criterion="major" @(Model.Criteria.Contains(criterion.Value) ? "checked" : null) />
                        <label class="form-check-label" for="crit_@criterion.Value">@criterion.Label</label>
                    </div>
                }
                <h3 class="h6 mt-3">Normal criteria</h3>
                @foreach (var criterion in normalCriteria)
                {
                    <div class="form-check">
                        <input type="checkbox" name="Criteria" value="@criterion.Value" class="form-check-input" id="crit_@criterion.Value" data-criterion="normal" @(Model.Criteria.Contains(criterion.Value) ? "checked" : null) />
                        <label class="form-check-label" for="crit_@criterion.Value">@criterion.Label</label>
                    </div>
                }
                <div class="alert alert-secondary mt-3 mb-0">
                    Resulting category: <strong id="category-preview">@Model.PreviewCategory</strong>
                    <div class="small text-muted">Final category is confirmed by the Release Manager and Technical Owner.</div>
                </div>
            </div>
            <div class="col-lg-6">
                <h3 class="h6">Security assessment triggers (§5.2)</h3>
                @foreach (var trigger in securityTriggers)
                {
                    <div class="form-check">
                        <input type="checkbox" name="Triggers" value="@trigger.Value" class="form-check-input" id="trig_@trigger.Value" @(Model.Triggers.Contains(trigger.Value) ? "checked" : null) />
                        <label class="form-check-label" for="trig_@trigger.Value">@trigger.Label</label>
                    </div>
                }
                <div class="form-text mb-3">When any trigger applies, InfoSec cannot mark security readiness as Not Required.</div>

                <h3 class="h6">Execution mode</h3>
                <select asp-for="ExecutionMode" class="form-select mb-2" asp-items="Html.GetEnumSelectList<ExecutionMode>()" id="execution-mode"></select>
                <div id="expedited-fields" class="@(Model.ExecutionMode == ExecutionMode.Expedited ? "" : "d-none")">
                    <label asp-for="ExpeditedJustification" class="form-label"></label>
                    <textarea asp-for="ExpeditedJustification" class="form-control mb-2" rows="3" placeholder="Business / service / security / incident urgency (§6.2)"></textarea>
                    <label asp-for="DirectorApprovalReference" class="form-label"></label>
                    <input asp-for="DirectorApprovalReference" class="form-control" placeholder="Required for significant impact (§6.2)" />
                    <div class="form-text">Expedited is not Change Management “Emergency”. A Post-Release Review is mandatory after an Expedited release.</div>
                </div>
            </div>
        </div>
    </section>

    <section class="panel @(Model.Step == 4 ? "" : "d-none")">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="h5 mb-1">Source links (§1.3, §8.1)</h2>
                <p class="text-muted mb-0">Link the authoritative sources — Azure Boards work item / PR / pipeline / artifact, Service Desk Change. Evidence stays in the source system; the record only references it. At least one source reference is required.</p>
            </div>
            <button type="button" class="btn btn-outline-secondary" id="add-reference-row">Add link</button>
        </div>
        <div id="references-grid">
            @for (var i = 0; i < Model.References.Count; i++)
            {
                <div class="row g-2 align-items-end mb-2" data-reference-row>
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <select name="References[@i].ReferenceType" class="form-select" asp-items="@(new SelectList(referenceTypes, Model.References[i].ReferenceType))"></select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">ID</label>
                        <input name="References[@i].ExternalId" value="@Model.References[i].ExternalId" class="form-control" placeholder="e.g. 12345" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">URL</label>
                        <input name="References[@i].Url" value="@Model.References[i].Url" class="form-control" placeholder="https://devops…" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Title</label>
                        <input name="References[@i].Title" value="@Model.References[i].Title" class="form-control" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100" data-remove-reference>×</button>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="panel @(Model.Step == 5 ? "" : "d-none")">
        <h2 class="h5">Readiness plans (§5) and recovery (§5.3)</h2>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="TestingSummary" class="form-label"></label>
                <textarea asp-for="TestingSummary" class="form-control" rows="4" placeholder="Summarize test scope and results; link the QA evidence on the previous step."></textarea>
            </div>
            <div class="col-md-4">
                <label asp-for="RecoveryApproach" class="form-label"></label>
                <select asp-for="RecoveryApproach" class="form-select" asp-items="Html.GetEnumSelectList<RecoveryApproach>()"></select>
                <div class="form-text">Minor: standard pipeline rollback · Normal: rollback/backout or roll-forward · Major: formal recovery plan.</div>
            </div>
            <div class="col-md-8">
                <label asp-for="RollbackPlan" class="form-label">Rollback / backout or roll-forward description</label>
                <textarea asp-for="RollbackPlan" class="form-control" rows="3"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="RecoveryDecisionPoints" class="form-label"></label>
                <textarea asp-for="RecoveryDecisionPoints" class="form-control" rows="3" placeholder="When do we decide to roll back? Who decides? (mandatory for Major)"></textarea>
            </div>
            <div class="col-md-6">
                <label asp-for="RecoveryResponsibleParties" class="form-label"></label>
                <textarea asp-for="RecoveryResponsibleParties" class="form-control" rows="3" placeholder="Responsible parties for recovery (mandatory for Major)"></textarea>
            </div>
            <div class="col-md-6"><label asp-for="DeploymentPlan" class="form-label"></label><textarea asp-for="DeploymentPlan" class="form-control" rows="3"></textarea></div>
            <div class="col-md-6"><label asp-for="MonitoringPlan" class="form-label"></label><textarea asp-for="MonitoringPlan" class="form-control" rows="3"></textarea></div>
            <div class="col-md-6"><label asp-for="PostReleaseValidationPlan" class="form-label"></label><textarea asp-for="PostReleaseValidationPlan" class="form-control" rows="3"></textarea></div>
            <div class="col-md-3">
                <div class="form-check mt-4"><input asp-for="DowntimeRequired" class="form-check-input" id="downtime-required" /><label asp-for="DowntimeRequired" class="form-check-label"></label></div>
                <div class="form-check"><input asp-for="OperationalImpact" class="form-check-input" /><label asp-for="OperationalImpact" class="form-check-label"></label></div>
            </div>
            <div class="col-md-3"><label asp-for="ExpectedDowntimeMinutes" class="form-label"></label><input asp-for="ExpectedDowntimeMinutes" class="form-control" min="0" /></div>
        </div>
    </section>

    <section class="panel @(Model.Step == 6 ? "" : "d-none")">
        <h2 class="h5">Review</h2>
        <dl class="status-summary">
            <div><dt>Title</dt><dd>@Model.Title</dd></div>
            <div><dt>Version</dt><dd>@(Model.ReleaseVersion ?? "—")</dd></div>
            <div><dt>Planned window</dt><dd>@Model.PlannedWindowStart.ToString("g") – @Model.PlannedWindowEnd.ToString("g")</dd></div>
            <div><dt>Track / category / mode</dt><dd>Application / <strong>@Model.PreviewCategory</strong> / @Model.ExecutionMode</dd></div>
            <div><dt>Recovery approach</dt><dd>@Model.RecoveryApproach</dd></div>
            <div><dt>Services</dt><dd>@Model.Services.Count(service => service.ServiceId != Guid.Empty)</dd></div>
            <div><dt>Source links</dt><dd>@Model.References.Count(reference => !string.IsNullOrWhiteSpace(reference.ExternalId))</dd></div>
            <div><dt>Planned maintenance</dt><dd>@(Model.PlannedMaintenance ? "Yes" : "No")</dd></div>
            <div><dt>Security triggers</dt><dd>@(Model.Triggers.Count == 0 ? "None" : string.Join(", ", Model.Triggers))</dd></div>
        </dl>
        <hr />
        <h3 class="h6">Description</h3>
        <p class="mb-0" style="white-space: pre-wrap">@Model.Description</p>
    </section>

    <div class="d-flex gap-2 justify-content-between">
        <button type="submit" name="action" value="save" class="btn btn-outline-secondary">Save Draft</button>
        <div class="d-flex gap-2">
            @if (Model.Step > 1)
            {
                <button type="submit" name="action" value="previous" class="btn btn-outline-secondary">Previous</button>
            }
            @if (Model.Step < 6)
            {
                <button type="submit" name="action" value="next" class="btn btn-accent">Next</button>
            }
            else
            {
                <button type="submit" name="action" value="submit" class="btn btn-accent">Submit release</button>
            }
        </div>
    </div>
</form>

<template id="service-row-template">
    <div class="service-row panel panel-nested" data-service-row>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="service-row-title">Service</strong>
            <button type="button" class="btn btn-sm btn-outline-danger" data-remove-service>Remove</button>
        </div>
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label">Service</label>
                <select name="Services[__index__].ServiceId" class="form-select" data-service-select>
                    <option value="">Select service</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Branch</label>
                <input name="Services[__index__].BranchName" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Commit</label>
                <input name="Services[__index__].CommitId" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Version</label>
                <input name="Services[__index__].Version" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Build</label>
                <input name="Services[__index__].BuildNumber" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Repository URL</label>
                <input name="Services[__index__].RepositoryUrl" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Notes</label>
                <input name="Services[__index__].Notes" class="form-control" />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input type="checkbox" name="Services[__index__].DatabaseChanges" value="true" class="form-check-input" data-db-check />
                    <label class="form-check-label" data-db-label>Database changes</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check mt-2">
                    <input type="checkbox" name="Services[__index__].ConfigurationChanges" value="true" class="form-check-input" data-cfg-check />
                    <label class="form-check-label" data-cfg-label>Configuration changes</label>
                </div>
            </div>
        </div>
    </div>
</template>

<template id="reference-row-template">
    <div class="row g-2 align-items-end mb-2" data-reference-row>
        <div class="col-md-3">
            <label class="form-label">Type</label>
            <select name="References[__index__].ReferenceType" class="form-select">
                @foreach (var type in referenceTypes)
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">ID</label>
            <input name="References[__index__].ExternalId" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">URL</label>
            <input name="References[__index__].Url" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Title</label>
            <input name="References[__index__].Title" class="form-control" />
        </div>
        <div class="col-md-1">
            <button type="button" class="btn btn-outline-danger w-100" data-remove-reference>×</button>
        </div>
    </div>
</template>
