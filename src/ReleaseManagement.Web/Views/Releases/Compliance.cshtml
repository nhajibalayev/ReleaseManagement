@model ReleaseManagement.Application.DTOs.Procedure.CompliancePackDto
@{
    ViewData["Title"] = $"CBAR 7.28 — {Model.ReleaseNumber}";
}

<div class="panel">
    <div class="d-flex flex-wrap justify-content-between gap-3">
        <div>
            <div class="text-muted fw-semibold">CBAR 7.28 evidence pack (Appendix A)</div>
            <h1 class="h3 mb-2"><a asp-action="Details" asp-route-id="@Model.ReleaseId">@Model.ReleaseNumber</a> — @Model.Title</h1>
            <span class="status-badge @(Model.IsFullyMapped ? "ok" : "action")">@(Model.IsFullyMapped ? "All clauses evidenced" : $"{Model.Items.Count(i => !i.IsSatisfied)} clause(s) with gaps")</span>
        </div>
        <div class="text-md-end text-muted">
            <div>Generated @Model.GeneratedAtUtc.ToLocalTime().ToString("g")</div>
            <button class="btn btn-sm btn-outline-secondary mt-2" onclick="window.print()">Print</button>
        </div>
    </div>
</div>

<section class="panel">
    <table class="table align-middle mb-0">
        <thead><tr><th style="width: 90px">Clause</th><th>Requirement</th><th>Evidence (links / statuses in the Release Record)</th><th style="width: 120px">Result</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><strong>@item.Clause</strong></td>
                <td>@item.Requirement@if (!item.IsSatisfied && !string.IsNullOrWhiteSpace(item.Gap)) { <div class="small text-danger">@item.Gap</div> }</td>
                <td>
                    @if (item.Evidence.Any())
                    {
                        <ul class="mb-0 small">@foreach (var evidence in item.Evidence) { <li>@evidence</li> }</ul>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </td>
                <td><span class="status-badge @(item.IsSatisfied ? "ok" : "danger")">@(item.IsSatisfied ? "Evidenced" : "Gap")</span></td>
            </tr>
        }
        </tbody>
    </table>
</section>
