@model ReleaseWizardViewModel
@{
    ViewData["Title"] = "Create Release";
    ViewData["FormAction"] = "Create";
}

<div class="mb-3">
    <h1 class="h3 mb-1">Create release</h1>
    <p class="text-muted mb-0">Complete the six steps of the Release Record (§8.2), save a draft, or submit it to the Release Manager.</p>
</div>
<partial name="_WizardForm" model="Model" view-data="ViewData" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
