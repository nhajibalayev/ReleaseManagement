@model ReleaseWizardViewModel
@{
    ViewData["Title"] = "Create Release";
    ViewData["FormAction"] = "Create";
}

<div class="form-page">
<div class="mb-3">
    <h1 class="h3 mb-1">Create release</h1>
    <p class="text-muted mb-0">Six short steps. Fields marked * are required to save; everything else can be completed later or left empty for Minor releases.</p>
</div>
<partial name="_WizardForm" model="Model" view-data="ViewData" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
