@model KpiPageViewModel
@{
    ViewData["Title"] = "Governance KPIs";
    string Pct(double? value) => value.HasValue ? $"{value.Value:N1}%" : "—";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Release KPIs (§9)</h1>
        <p class="text-muted mb-0">Monthly: Release Success Rate, Release-related Incident Rate, Rollback / Remediation Rate and Schedule Adherence (deployment within the approved window). IT Governance reviews trends and repeated failures. DORA metrics are out of scope.</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <select name="months" class="form-select" style="width: 140px">
            @foreach (var option in new[] { 3, 6, 12 }) { <option value="@option" selected="@(Model.Months.Count == option)">Last @option months</option> }
        </select>
        <button class="btn btn-outline-secondary" type="submit">Show</button>
    </form>
</div>

<div class="stat-grid mb-4">
    <div class="stat-card"><div class="label">Releases in readiness</div><div class="value">@Model.ReleasesInReadiness</div></div>
    <div class="stat-card"><div class="label">Open post-release reviews</div><div class="value">@Model.OpenReviews</div></div>
    <div class="stat-card"><div class="label">Active freeze periods</div><div class="value">@Model.ActiveFreezes</div></div>
</div>

<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Month</th>
                    <th class="text-end">Deployed</th>
                    <th class="text-end">Completed</th>
                    <th class="text-end">Success rate</th>
                    <th class="text-end">Incident rate</th>
                    <th class="text-end">Rollback / remediation</th>
                    <th class="text-end">Schedule adherence</th>
                    <th class="text-end">Expedited</th>
                    <th class="text-end">Open PIRs</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var month in Model.Months)
            {
                <tr>
                    <td>@(new DateTime(month.Year, month.Month, 1).ToString("MMMM yyyy"))</td>
                    <td class="text-end">@month.DeployedReleases</td>
                    <td class="text-end">@month.CompletedReleases</td>
                    <td class="text-end">@Pct(month.SuccessRatePercent) <span class="small text-muted">(@month.SuccessfulReleases/@month.CompletedReleases)</span></td>
                    <td class="text-end">@Pct(month.IncidentRatePercent) <span class="small text-muted">(@month.ReleasesWithIncidents)</span></td>
                    <td class="text-end">@Pct(month.RollbackRemediationRatePercent) <span class="small text-muted">(@month.RolledBackOrRemediated)</span></td>
                    <td class="text-end">@Pct(month.ScheduleAdherencePercent) <span class="small text-muted">(@month.DeployedWithinWindow/@month.DeployedReleases)</span></td>
                    <td class="text-end">@month.ExpeditedReleases</td>
                    <td class="text-end">@month.OpenPirs</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <p class="small text-muted mt-3 mb-0">Success rate = Successful / (Successful + Failed + Rolled Back + Remediated) by closure month. Incident rate uses Incident references linked on the release (Service Desk). Schedule adherence allows a 15-minute tolerance around the planned window.</p>
</section>
