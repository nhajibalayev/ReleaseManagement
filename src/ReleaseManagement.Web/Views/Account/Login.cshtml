@model LoginViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Sign in";
    Layout = "_Layout";
}

<div class="login-shell">
    <div class="login-card">
        <h1>Release Management</h1>
        <p>Sign in to manage release requests and approvals.</p>
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger small">@error</div>
        }
        @if (Configuration.GetValue<bool>("DemoMode"))
        {
            <div class="alert alert-info small">
                <strong>Demo mode:</strong> data is kept in memory and resets on restart.<br />
                Login: <code>po</code> / <code>ChangeMe!123</code>
            </div>
        }

        @if (Model.WindowsAuthEnabled)
        {
            <a class="btn btn-outline-secondary w-100 mb-3"
               asp-action="WindowsLogin"
               asp-route-returnUrl="@Model.ReturnUrl">
                Sign in with Windows (integrated)
            </a>
        }

        @if (Model.AzureAdEnabled)
        {
            <a class="btn btn-outline-primary w-100 mb-3"
               asp-action="ExternalLogin"
               asp-route-returnUrl="@Model.ReturnUrl">
                Sign in with Microsoft
            </a>
        }

        @if (Model.AllowLocalLogin || Model.ActiveDirectoryLoginEnabled)
        {
            @if (!string.IsNullOrWhiteSpace(Model.LoginHint))
            {
                <div class="alert alert-info small">@Model.LoginHint</div>
            }
            else if (Model.WindowsAuthEnabled || Model.AzureAdEnabled)
            {
                <div class="text-center text-muted small mb-3">or use a local account</div>
            }
            <form asp-controller="Account" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <input asp-for="ReturnUrl" type="hidden" />
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">
                        @(Model.ActiveDirectoryLoginEnabled ? "AD user name" : "User name")
                    </label>
                    <input asp-for="UserName" class="form-control" autocomplete="username" autofocus
                           placeholder="@(Model.ActiveDirectoryLoginEnabled ? @"DOMAIN\user or user" : null)" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-accent w-100">
                    @(Model.ActiveDirectoryLoginEnabled ? "Sign in with Active Directory" : "Sign in")
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
