@model CalendarPageViewModel
@{
    ViewData["Title"] = "Release Calendar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Release Calendar</h1>
        <p class="text-muted mb-0">Single calendar per §3.2: Release ID, track, category, execution mode, service / product, planned window, Release Manager, downtime / customer impact and key dependencies. Dates are shown in local time.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Forecasts" asp-action="Index" class="btn btn-outline-secondary">Quarterly forecast</a>
        <a asp-controller="Freezes" asp-action="Index" class="btn btn-outline-secondary">Freeze periods</a>
    </div>
</div>

@if (Model.Freezes.Any())
{
    <section class="panel">
        <h2 class="h6">Active freeze periods (§6.3)</h2>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var freeze in Model.Freezes)
            {
                <span class="status-badge danger">@freeze.Name · @freeze.FreezeType · @freeze.StartDate.ToLocalTime().ToString("d") – @freeze.EndDate.ToLocalTime().ToString("d") · @freeze.Authority</span>
            }
        </div>
    </section>
}

<section class="panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Planned window</th>
                    <th>Release</th>
                    <th>Track / category / mode</th>
                    <th>Product · services</th>
                    <th>Environment</th>
                    <th>Release Manager</th>
                    <th>Downtime / maintenance</th>
                    <th>Dependencies</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var release in Model.Releases)
            {
                <tr class="@(release.InFreeze ? "table-warning" : "")">
                    <td class="small">@release.WindowStart.ToLocalTime().ToString("g")<br />@release.WindowEnd.ToLocalTime().ToString("g")</td>
                    <td><strong>@release.ReleaseNumber</strong><div class="small text-muted">@release.Title</div></td>
                    <td>@release.Track<br /><span class="status-badge @(release.Category == ReleaseCategory.Major ? "danger" : "")">@release.Category</span> <span class="status-badge @(release.ExecutionMode == ExecutionMode.Expedited ? "danger" : "")">@release.ExecutionMode</span></td>
                    <td>@(release.ProductName ?? "—")<div class="small text-muted">@release.Services</div></td>
                    <td>@(release.EnvironmentName ?? "—")</td>
                    <td>@(release.ReleaseManagerName ?? "—")</td>
                    <td class="small">@(release.DowntimeRequired ? $"{release.ExpectedDowntimeMinutes ?? 0} min downtime" : "No downtime")@if (release.PlannedMaintenance) { <div>Planned maintenance</div> }@if (release.InFreeze) { <div class="text-danger">In freeze</div> }</td>
                    <td class="small">@(string.IsNullOrWhiteSpace(release.KeyDependencies) ? "—" : release.KeyDependencies)</td>
                    <td><span class="status-badge">@release.CurrentStatusDisplay</span></td>
                    <td class="text-end"><a asp-controller="Releases" asp-action="Details" asp-route-id="@release.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                </tr>
            }
            @if (!Model.Releases.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">No scheduled releases.</td></tr> }
            </tbody>
        </table>
    </div>
</section>
