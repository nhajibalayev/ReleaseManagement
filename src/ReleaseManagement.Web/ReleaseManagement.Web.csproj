<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ReleaseManagement.Application\ReleaseManagement.Application.csproj" />
    <ProjectReference Include="..\ReleaseManagement.Infrastructure\ReleaseManagement.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Build-time asset compression emits unresolvable ".gz" endpoints, so gzip-capable
         clients receive empty responses. Serve static assets uncompressed instead. -->
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

</Project>
