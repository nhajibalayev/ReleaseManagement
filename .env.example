# Copy to .env and fill in. .env is git-ignored.

# --- PostgreSQL (remote server) ---
DB_HOST=postgres.nh-nk.az
DB_PORT=5432
DB_NAME=release_management
DB_USER=release_management
DB_PASSWORD=change-me

# --- Active Directory login (LDAP path is used inside the Linux container) ---
AD_ENABLED=true
# Real = validate against the domain; Mock = any user with password Mock!123 (no corp network)
AD_MODE=Real
AD_DOMAIN=NH-NK
# Domain controller host name (FQDN). Ask IT if unsure: e.g. dc01.nh-nk.az
AD_LDAP_SERVER=dc01.nh-nk.az
# 0 = default (389, or 636 with SSL)
AD_LDAP_PORT=0
AD_LDAP_USE_SSL=false
AD_LDAP_SKIP_CERT_VALIDATION=false
# Short (NetBIOS) domain for NTLM to Azure DevOps Server, e.g. TEST-NAMIQ (echo %USERDOMAIN%)
AD_NETBIOS_DOMAIN=
# NTLM to DevOps Server: true = managed .NET NTLM (default), false = system GSSAPI/gss-ntlmssp. Try false if 401 persists.
NTLM_MANAGED=true
# true = the local "admin" account (and other local accounts) can sign in alongside AD users
AD_ALLOW_LOCAL_LOGIN=true
AD_DEFAULT_ROLE=ProductOwner

# --- Azure DevOps Server ---
ADO_ENABLED=true
# Real = call devops.nh-nk.az; Mock = in-memory work items
ADO_MODE=Real
ADO_ORG_URL=https://devops.nh-nk.az/DefaultCollection
ADO_PROJECT=Release Management Board
ADO_WORK_ITEM_TYPE=Release
ADO_API_VERSION=6.0
ADO_REQUIRE_PROJECT_ACCESS=true
ADO_CREATE_WORK_ITEM_ON_SUBMIT=false

# --- Vault ---
# true = compile in PL.Common.SecretVault (corporate NuGet required). Local runs: false.
CORP_VAULT=false

# --- Misc ---
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
SEED_ENABLED=false
# Apply EF migrations on startup (Docker Desktop convenience; DevOps may set false in Kubernetes)
APPLY_MIGRATIONS=true
# Built-in local administrator, created on first start if missing. Change the password after first login.
BOOTSTRAP_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe!123
DEMO_MODE=false
